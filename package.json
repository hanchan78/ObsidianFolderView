{
	"name": "folder-view",
	"version": "1.0.3",
	"description": "Render searchable, collapsible folder trees inside Obsidian notes.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check": "npm run lint && npm run build && node scripts/validate-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"folder-tree"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hanchan78/ObsidianFolderView.git"
	},
	"bugs": {
		"url": "https://github.com/hanchan78/ObsidianFolderView/issues"
	},
	"homepage": "https://github.com/hanchan78/ObsidianFolderView#readme",
	"license": "0-BSD",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"@eslint/js": "9.30.1",
		"jiti": "2.6.1"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
